{
  "name": "ChatMessage",
  "type": "object",
  "properties": {
    "author_name": {
      "type": "string",
      "title": "Author Name",
      "description": "Display name of the sender (empire name)."
    },
    "message": {
      "type": "string",
      "title": "Message",
      "description": "The chat message body."
    },
    "pinned": {
      "type": "boolean",
      "title": "Pinned",
      "description": "Admin-pinned message shown at the top of the channel and preserved from pruning.",
      "default": false
    },
    "is_announcement": {
      "type": "boolean",
      "title": "Announcement",
      "description": "Admin announcement rendered with special emphasis.",
      "default": false
    }
  },
  "required": [
    "message"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}