{
  "name": "Alliance",
  "type": "object",
  "properties": {
    "alliance_name": {
      "type": "string",
      "title": "Alliance Name",
      "description": "The unique name of the alliance."
    },
    "description": {
      "type": "string",
      "title": "Description",
      "description": "Short charter or motto for the alliance."
    },
    "founder_name": {
      "type": "string",
      "title": "Founder Name",
      "description": "Denormalized empire name of the founding ruler."
    }
  },
  "required": [
    "alliance_name"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}