{
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "chat_banned": {
      "type": "boolean",
      "title": "Chat Banned",
      "description": "When true, the user cannot post in the comms channel.",
      "default": false
    },
    "chat_muted_until": {
      "type": "string",
      "format": "date-time",
      "title": "Chat Muted Until",
      "description": "ISO timestamp; the user cannot post until this time passes. Null when not muted."
    }
  },
  "required": [
    "role"
  ],
  "name": "User",
  "type": "object"
}