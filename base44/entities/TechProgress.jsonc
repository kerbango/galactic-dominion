{
  "name": "TechProgress",
  "type": "object",
  "properties": {
    "tech_id": {
      "type": "string",
      "title": "Tech ID",
      "description": "The technology being researched (matches an id in the tech tree dataset)."
    },
    "status": {
      "type": "string",
      "title": "Status",
      "description": "researching = in progress, completed = finished. 'available' is implicit (no record).",
      "enum": [
        "researching",
        "completed"
      ],
      "default": "researching"
    },
    "progress": {
      "type": "number",
      "title": "Progress",
      "description": "Turns of research completed toward this tech.",
      "default": 0,
      "minimum": 0
    },
    "research_turns": {
      "type": "number",
      "title": "Research Turns",
      "description": "Snapshot of the tech's researchTurns at start, used by the hourly tick to know when to complete.",
      "default": 1,
      "minimum": 1
    }
  },
  "required": [
    "tech_id",
    "status"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}