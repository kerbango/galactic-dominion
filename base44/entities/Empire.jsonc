{
  "name": "Empire",
  "type": "object",
  "properties": {
    "empire_name": {
      "type": "string",
      "title": "Empire Name",
      "description": "The player-chosen name of their empire."
    },
    "ruler_name": {
      "type": "string",
      "title": "Ruler Name",
      "description": "The player's in-game identity name (not their email)."
    },
    "aetherium_crystal": {
      "type": "number",
      "title": "Aetherium Crystal",
      "description": "Rare crystal resource used for advanced construction and upgrades.",
      "default": 1000,
      "minimum": 0
    },
    "ferrite_titanium": {
      "type": "number",
      "title": "Ferrite-Titanium",
      "description": "Alloy used for building ships and structures.",
      "default": 1000,
      "minimum": 0
    },
    "energy": {
      "type": "number",
      "title": "Energy",
      "description": "Power used to run operations, fleets, and facilities.",
      "default": 500,
      "minimum": 0
    },
    "vrind": {
      "type": "number",
      "title": "VRIND",
      "description": "Galactic currency for trade, transactions, research, and unit construction.",
      "default": 500,
      "minimum": 0
    },
    "berentium": {
      "type": "number",
      "title": "Berentium",
      "description": "Rare mined ore used for advanced alloys and exotic construction.",
      "default": 500,
      "minimum": 0
    },
    "research_points": {
      "type": "number",
      "title": "Research Points",
      "description": "Currency produced each production cycle and spent alongside VRIND to start research. Base 1/cycle, raised by the Research Point Synthesis upgrade.",
      "default": 0,
      "minimum": 0
    },
    "population": {
      "type": "number",
      "title": "Population",
      "description": "Total population of the empire. Grows via upgrades and research, not passive production.",
      "default": 1000000,
      "minimum": 0
    },
    "map_x": {
      "type": "number",
      "title": "Map X",
      "description": "X coordinate of the empire on the galactic map.",
      "minimum": 0
    },
    "map_y": {
      "type": "number",
      "title": "Map Y",
      "description": "Y coordinate of the empire on the galactic map.",
      "minimum": 0
    },
    "last_tick_date": {
      "type": "string",
      "format": "date-time",
      "title": "Last Tick Date",
      "description": "ISO timestamp of the most recent resource tick applied to this empire."
    },
    "martial_law_active_until": {
      "type": "string",
      "format": "date-time",
      "title": "Martial Law Active Until",
      "description": "ISO timestamp until which martial law's 5x production boost is active. Null when not active."
    },
    "martial_law_cooldown_until": {
      "type": "string",
      "format": "date-time",
      "title": "Martial Law Cooldown Until",
      "description": "ISO timestamp until which martial law cannot be reactivated. Null when ready."
    },
    "research_speed_level": {
      "type": "number",
      "title": "Research Speed Level",
      "description": "Purchased tier of the research-speed upgrade (0-3). Each level shortens all research completion times; stacks with the Quantum Computing tech bonus.",
      "default": 0,
      "minimum": 0
    },
    "research_points_production_level": {
      "type": "number",
      "title": "Research Points Production Level",
      "description": "Purchased tier of the Research Point Synthesis upgrade (0-3). Each level adds +1 Research Point per production cycle (base 1).",
      "default": 0,
      "minimum": 0
    }
  },
  "required": [
    "empire_name",
    "ruler_name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}