{
  "name": "Empire",
  "type": "object",
  "properties": {
    "empire_name": {
      "type": "string",
      "title": "Empire Name",
      "description": "The player-chosen name of their empire."
    },
    "ruler_name": {
      "type": "string",
      "title": "Ruler Name",
      "description": "The player's in-game identity name (not their email)."
    },
    "aetherium_crystal": {
      "type": "number",
      "title": "Aetherium Crystal",
      "description": "Rare crystal resource used for advanced construction and research.",
      "default": 1000,
      "minimum": 0
    },
    "ferrite_titanium": {
      "type": "number",
      "title": "Ferrite-Titanium",
      "description": "Alloy used for building ships and structures.",
      "default": 1000,
      "minimum": 0
    },
    "energy": {
      "type": "number",
      "title": "Energy",
      "description": "Power used to run operations, fleets, and facilities.",
      "default": 500,
      "minimum": 0
    },
    "vrind": {
      "type": "number",
      "title": "VRIND",
      "description": "Galactic currency for trade and transactions.",
      "default": 500,
      "minimum": 0
    },
    "berentium": {
      "type": "number",
      "title": "Berentium",
      "description": "Rare mined ore used for advanced alloys and exotic construction.",
      "default": 500,
      "minimum": 0
    },
    "map_x": {
      "type": "number",
      "title": "Map X",
      "description": "X coordinate of the empire on the galactic map.",
      "minimum": 0
    },
    "map_y": {
      "type": "number",
      "title": "Map Y",
      "description": "Y coordinate of the empire on the galactic map.",
      "minimum": 0
    },
    "last_tick_date": {
      "type": "string",
      "format": "date-time",
      "title": "Last Tick Date",
      "description": "ISO timestamp of the most recent resource tick applied to this empire."
    }
  },
  "required": [
    "empire_name",
    "ruler_name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}