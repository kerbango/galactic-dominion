{
  "name": "Fleet",
  "type": "object",
  "properties": {
    "target_empire_id": {
      "type": "string",
      "title": "Target Empire ID"
    },
    "target_owner_id": {
      "type": "string",
      "title": "Target Owner ID"
    },
    "target_empire_name": {
      "type": "string",
      "title": "Target Empire Name"
    },
    "origin_empire_name": {
      "type": "string",
      "title": "Origin Empire Name"
    },
    "origin_x": {
      "type": "number",
      "minimum": 0
    },
    "origin_y": {
      "type": "number",
      "minimum": 0
    },
    "target_x": {
      "type": "number",
      "minimum": 0
    },
    "target_y": {
      "type": "number",
      "minimum": 0
    },
    "fleet_size": {
      "type": "number",
      "default": 1,
      "minimum": 1
    },
    "mission_type": {
      "type": "string",
      "enum": [
        "attack",
        "scout"
      ],
      "default": "attack"
    },
    "scout_class": {
      "type": "string",
      "enum": [
        "light",
        "medium",
        "heavy"
      ]
    },
    "scout_unit_type": {
      "type": "string",
      "enum": [
        "light_scout",
        "medium_scout",
        "heavy_scout"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "in_transit",
        "in_battle",
        "arrived",
        "awaiting_recon",
        "scouting"
      ],
      "default": "in_transit"
    },
    "leg": {
      "type": "string",
      "enum": [
        "outbound",
        "return"
      ],
      "default": "outbound"
    },
    "departure_date": {
      "type": "string",
      "format": "date-time"
    },
    "arrival_date": {
      "type": "string",
      "format": "date-time"
    },
    "battle_end_date": {
      "type": "string",
      "format": "date-time"
    },
    "recon_start_date": {
      "type": "string",
      "format": "date-time",
      "title": "Recon Start Date"
    },
    "recon_end_date": {
      "type": "string",
      "format": "date-time",
      "title": "Recon End Date"
    },
    "return_departure_date": {
      "type": "string",
      "format": "date-time"
    },
    "return_arrival_date": {
      "type": "string",
      "format": "date-time"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "win",
        "loss"
      ]
    },
    "survivors": {
      "type": "number",
      "minimum": 0
    },
    "loot": {
      "type": "object",
      "properties": {
        "aetherium_crystal": {
          "type": "number",
          "minimum": 0
        },
        "ferrite_titanium": {
          "type": "number",
          "minimum": 0
        },
        "energy": {
          "type": "number",
          "minimum": 0
        },
        "vrind": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "ground_forces": {
      "type": "object",
      "default": {},
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      }
    },
    "ship_manifest": {
      "type": "object",
      "title": "Ship Manifest",
      "description": "Map of deployed warship unit_type to count for attack fleets. Built ships are subtracted from the Unit inventory at dispatch and partially restored from survivors on return.",
      "default": {},
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      }
    },
    "ground_outcome": {
      "type": "string",
      "enum": [
        "win",
        "loss"
      ]
    },
    "ground_survivors": {
      "type": "object",
      "default": {},
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      }
    }
  },
  "required": [
    "target_empire_id",
    "target_empire_name",
    "origin_x",
    "origin_y",
    "target_x",
    "target_y",
    "departure_date",
    "arrival_date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.target_owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}