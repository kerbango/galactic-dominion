{
  "name": "Fleet",
  "type": "object",
  "properties": {
    "target_empire_id": {
      "type": "string",
      "title": "Target Empire ID",
      "description": "The empire this fleet is travelling toward."
    },
    "target_empire_name": {
      "type": "string",
      "title": "Target Empire Name",
      "description": "Denormalized target empire name for map display."
    },
    "origin_empire_name": {
      "type": "string",
      "title": "Origin Empire Name",
      "description": "Denormalized origin empire name for map display."
    },
    "origin_x": {
      "type": "number",
      "title": "Origin X",
      "description": "Grid X coordinate the fleet departed from.",
      "minimum": 0
    },
    "origin_y": {
      "type": "number",
      "title": "Origin Y",
      "description": "Grid Y coordinate the fleet departed from.",
      "minimum": 0
    },
    "target_x": {
      "type": "number",
      "title": "Target X",
      "description": "Grid X coordinate the fleet is heading to.",
      "minimum": 0
    },
    "target_y": {
      "type": "number",
      "title": "Target Y",
      "description": "Grid Y coordinate the fleet is heading to.",
      "minimum": 0
    },
    "fleet_size": {
      "type": "number",
      "title": "Fleet Size",
      "description": "Number of ships in the fleet.",
      "default": 1,
      "minimum": 1
    },
    "status": {
      "type": "string",
      "title": "Status",
      "description": "Movement status of the fleet. in_transit = travelling a leg; in_battle = fighting at the target during the battle window; arrived = home and resolved.",
      "enum": [
        "in_transit",
        "in_battle",
        "arrived"
      ],
      "default": "in_transit"
    },
    "leg": {
      "type": "string",
      "title": "Leg",
      "description": "Which leg of the round trip the fleet is on: outbound (home \u2192 target) or return (target \u2192 home).",
      "enum": [
        "outbound",
        "return"
      ],
      "default": "outbound"
    },
    "departure_date": {
      "type": "string",
      "format": "date-time",
      "title": "Departure Date",
      "description": "When the fleet departed its origin."
    },
    "arrival_date": {
      "type": "string",
      "format": "date-time",
      "title": "Arrival Date",
      "description": "When the fleet is scheduled to arrive at its target."
    },
    "battle_end_date": {
      "type": "string",
      "format": "date-time",
      "title": "Battle End Date",
      "description": "When the in-battle window ends and combat resolves. Set when the fleet enters status=in_battle."
    },
    "return_departure_date": {
      "type": "string",
      "format": "date-time",
      "title": "Return Departure Date",
      "description": "When the return leg departed the target (set after combat resolves)."
    },
    "return_arrival_date": {
      "type": "string",
      "format": "date-time",
      "title": "Return Arrival Date",
      "description": "When the return leg is scheduled to arrive back home."
    },
    "outcome": {
      "type": "string",
      "title": "Outcome",
      "description": "Combat result at the target: win or loss. Null until resolved.",
      "enum": [
        "win",
        "loss"
      ]
    },
    "survivors": {
      "type": "number",
      "title": "Survivors",
      "description": "Ships that survived combat and are returning home.",
      "minimum": 0
    },
    "loot": {
      "type": "object",
      "title": "Loot",
      "description": "Resources stolen from the target on a winning attack, deposited home on return arrival. Null on a loss.",
      "properties": {
        "aetherium_crystal": {
          "type": "number",
          "minimum": 0
        },
        "ferrite_titanium": {
          "type": "number",
          "minimum": 0
        },
        "energy": {
          "type": "number",
          "minimum": 0
        },
        "vrind": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  },
  "required": [
    "target_empire_id",
    "target_empire_name",
    "origin_x",
    "origin_y",
    "target_x",
    "target_y",
    "departure_date",
    "arrival_date"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}