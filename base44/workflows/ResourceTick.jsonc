{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 * * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Grants accumulated production to every empire on a recurring schedule so resources persist and accumulate while players are offline. cyclesDue batches owed cycles, so the per-minute production rate is preserved regardless of tick cadence.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "resource_tick",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "tick": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "tickResources"
          },
          "then": "end",
          "x-base44": {
            "title": "Tick all empires",
            "description": "Grant owed production cycles"
          }
        }
      }
    ]
  },
  "name": "Resource Tick"
}